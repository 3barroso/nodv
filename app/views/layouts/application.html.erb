<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Nodv" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Tailwind CSS compiled output %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="site-exit">
    <div class="group fixed right-4 top-4 z-[100] px-2 py-2">
      <button
        type="button"
        class="site-exit-button"
        aria-label="Leave this site quickly"
        title="Click to leave this site quickly, or press Esc twice."
        data-action="click->site-exit#exitSite"
      >
        <span class="site-exit-flag" aria-hidden="true">✕</span>
      </button>

      <span class="pointer-events-none absolute right-14 top-1/2 hidden -translate-y-1/2 rounded-md bg-slate-900/95 px-3 py-2 text-xs font-medium text-white shadow-lg group-hover:block group-focus-within:block">
        Click to leave this site quickly.<br>Press Esc twice to close.
      </span>
    </div>

    <nav>
      <%= link_to "Timeline", root_path %>
      <%= link_to "Resources", resources_path if !authenticated? %>
      <% if authenticated? %>
        <%= link_to "Resources (Public)", resources_path %>
        <%= link_to "Resources", admin_resources_path %>
        <%= link_to "Phases", admin_phases_path %>
        <%= link_to "Profile", admin_user_path(current_user.id) %>
        <%= link_to "Requests", admin_user_requests_path %>
        <%= link_to "Log Out", session_path, method: :delete, data: { turbo_method: :delete }  %>
      <% else %>
          <%= link_to "Login", new_session_path %>
          <%= link_to "Create Account", new_user_request_path %>
      <% end %>
    </nav>

    <div class="notice"><%= flash[:notice] %></div>
    <div class="alert"><%= flash[:alert] %></div>

    <main class="container mx-auto mt-28 px-5">
      <%= yield %>
    </main>
  </body>
</html>

<section class="mx-auto max-w-7xl space-y-10">
  <header class="border-b border-slate-200 pb-5">
    <h1 class="text-3xl font-bold text-slate-900">Phases</h1>
  </header>

  <% @phases.each do |phase| %>
    <%= render "phase_resource_section", phase: phase, phase_resources: @phase_resources_by_phase_id.fetch(phase.id, []) %>

    <% @sub_phases_by_parent_id.fetch(phase.id, []).each do |sub_phase| %>
      <%= render "phase_resource_section", phase: sub_phase, phase_resources: @phase_resources_by_phase_id.fetch(sub_phase.id, []), nested: true %>
    <% end %>
  <% end %>
</section>

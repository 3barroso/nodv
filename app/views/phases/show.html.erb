<div class="mx-auto max-w-5xl space-y-8">
  <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">Phase</p>
        <h1 class="mt-2 text-3xl font-bold text-slate-900"><%= @phase.name %></h1>
        <% if @phase.summary.present? %>
          <p class="mt-3 text-sm leading-6 text-slate-600"><%= @phase.summary %></p>
        <% elsif @phase.description.present? %>
          <p class="mt-3 text-sm leading-6 text-slate-600"><%= @phase.description %></p>
        <% end %>
      </div>

      <div class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600">
        <div class="font-semibold text-slate-900"><%= @phase_resources.count %> resources</div>
        <div class="mt-1"><%= @sub_phases.count %> sub-phase<%= 's' if @sub_phases.count != 1 %></div>
        
        <% if @phase.manageable_by?(current_user) %>
          <div class="flex-shrink-0">
            <%= link_to "Edit phase", edit_admin_phase_path(@phase), class: "inline-flex items-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
          </div>
        <% end %>
      </div>
    </div>

    <% if @phase.parent.present? %>
      <div class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600">
        <span class="font-medium text-slate-900">Parent phase:</span>
        <%= link_to @phase.parent.name, phase_path(@phase.parent), class: "ml-2 text-blue-600 hover:text-blue-700" %>
      </div>
    <% end %>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-semibold text-slate-900">Resources for this phase</h2>
        <p class="mt-1 text-sm text-slate-500">Resources directly attached to <%= @phase.name %>.</p>
      </div>
      <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700"><%= @phase_resources.count %></span>
    </div>

    <% if @phase_resources.any? %>
      <ul class="mt-6 space-y-3">
        <% @phase_resources.each do |resource| %>
          <li class="flex flex-col gap-2 rounded-lg border border-slate-200 p-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <div class="font-medium text-slate-900"><%= resource.name %></div>
              <% if resource.author.present? %>
                <div class="mt-1 text-sm text-slate-500">By <%= resource.author.pen_name %></div>
              <% end %>
            </div>
            <%= link_to "View resource", resource_path(resource), class: "inline-flex items-center rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-6 text-sm text-slate-500">No resources are attached to this phase yet.</p>
    <% end %>
  </section>

  <% if @sub_phases.any? %>
    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h2 class="text-2xl font-semibold text-slate-900">Sub-phases</h2>
          <p class="mt-1 text-sm text-slate-500">Each sub-phase below shows its own resources and count.</p>
        </div>
        <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700"><%= @sub_phases.count %></span>
      </div>

      <div class="mt-6 space-y-6">
        <% @sub_phases.each do |sub_phase| %>
          <% sub_phase_resources = sub_phase.resources.order(:name) %>
          <article class="rounded-xl border border-slate-200 bg-slate-50 p-5">
            <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
              <div>
                <h3 class="text-xl font-semibold text-slate-900"><%= sub_phase.name %></h3>
                <% if sub_phase.summary.present? %>
                  <p class="mt-2 text-sm leading-6 text-slate-600"><%= sub_phase.summary %></p>
                <% elsif sub_phase.description.present? %>
                  <p class="mt-2 text-sm leading-6 text-slate-600"><%= sub_phase.description %></p>
                <% end %>
              </div>
              
              <%= link_to "View phase", phase_path(sub_phase), class: "inline-flex items-center rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>

              <div class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-600">
                <span class="font-semibold text-slate-900"><%= sub_phase_resources.count %></span> resource<%= 's' if sub_phase_resources.count != 1 %>
              </div>
            </div>

            <div class="mt-4 flex items-center justify-between gap-4">
              <div class="text-sm text-slate-500">Resources attached to this sub-phase:</div>
              <%= link_to "View sub-phase", phase_path(sub_phase), class: "text-sm font-medium text-blue-600 hover:text-blue-700" %>
            </div>

            <% if sub_phase_resources.any? %>
              <ul class="mt-4 space-y-2">
                <% sub_phase_resources.each do |resource| %>
                  <li class="flex flex-col gap-2 rounded-lg border border-slate-200 bg-white p-3 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                      <div class="font-medium text-slate-900"><%= resource.name %></div>
                      <% if resource.author.present? %>
                        <div class="mt-1 text-sm text-slate-500">By <%= resource.author.pen_name %></div>
                      <% end %>
                    </div>
                    <%= link_to "View resource", resource_path(resource), class: "inline-flex items-center rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <p class="mt-4 text-sm text-slate-500">No resources are attached to this sub-phase yet.</p>
            <% end %>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>
</div>

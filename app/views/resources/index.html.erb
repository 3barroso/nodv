<section class="mx-auto max-w-7xl space-y-8">
	<header class="border-b border-slate-200 pb-5">
		<h1 class="text-3xl font-bold text-slate-900">Public resources</h1>
		<p class="mt-2 text-sm text-slate-600">Browse published resources by phase and audience.</p>
	</header>

	<section class="rounded-xl border border-slate-200 bg-white p-5 shadow-xs" aria-label="Filter resources">
		<%= form_with url: resources_path, method: :get, class: "grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:items-end" do %>
			<div>
				<%= label_tag :phase_id, "Phase", class: "mb-1 block text-sm font-medium text-slate-700" %>
				<%= select_tag :phase_id, options_for_select([["All phases", ""]] + @phase_options, @phase_id), class: "block w-full rounded-md border-slate-300 text-sm focus:border-blue-600 focus:ring-blue-600" %>
			</div>

			<div>
				<%= label_tag :audience_type_id, "Audience", class: "mb-1 block text-sm font-medium text-slate-700" %>
				<%= select_tag :audience_type_id, options_for_select([["All audiences", ""]] + @audience_types.map { |audience_type| [audience_type.name, audience_type.id] }, @audience_type_id), class: "block w-full rounded-md border-slate-300 text-sm focus:border-blue-600 focus:ring-blue-600" %>
			</div>

			<div>
				<%= label_tag :sort, "Order", class: "mb-1 block text-sm font-medium text-slate-700" %>
				<%= select_tag :sort, options_for_select([["Newest first", "created_at_desc"], ["Oldest first", "created_at_asc"]], @sort), class: "block w-full rounded-md border-slate-300 text-sm focus:border-blue-600 focus:ring-blue-600" %>
			</div>

			<div class="flex gap-2">
				<%= submit_tag "Apply filters", class: "inline-flex items-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700" %>
				<%= link_to "Clear", resources_path, class: "inline-flex items-center rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
			</div>
		<% end %>
	</section>

	<section aria-label="Published resources">
		<div class="mb-4 flex items-center justify-between border-b border-slate-200 pb-3">
			<h2 class="text-xl font-semibold text-slate-900">Resources</h2>
			<span class="text-sm text-slate-500"><%= @resources.size %> found</span>
		</div>

		<% if @resources.any? %>
			<ul class="divide-y divide-slate-200">
				<% @resources.each do |resource| %>
					<li class="flex flex-col gap-3 py-5 sm:flex-row sm:items-center sm:justify-between">
						<div class="min-w-0">
							<h3 class="text-lg font-semibold text-slate-900"><%= resource.name %></h3>
							<p class="mt-1 text-sm text-slate-600">
								<span class="font-medium text-slate-700">Phase:</span>
								<% if resource.phases.any? %>
									<%= safe_join(resource.phases.map { |phase| link_to(phase.parent ? "#{phase.parent.name} / #{phase.name}" : phase.name, phase_path(phase), class: "text-blue-700 hover:text-blue-800") }, ", ") %>
								<% else %>
									Not assigned
								<% end %>
							</p>
						</div>
						<%= link_to "View resource", resource_path(resource), class: "inline-flex shrink-0 items-center rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
					</li>
				<% end %>
			</ul>
		<% else %>
			<p class="py-8 text-center text-sm text-slate-500">No published resources match these filters.</p>
		<% end %>
	</section>
</section>

<%= form_with model: form_model, local: true, html: { multipart: true } do |f| %>
  <% if form_model.is_a?(Array) ? form_model.last.errors.any? : form_model.errors.any? %>
    <div>
      <h2><%= pluralize((form_model.is_a?(Array) ? form_model.last : form_model).errors.count, "error") %> prevented this request from being saved:</h2>
      <ul>
        <% ((form_model.is_a?(Array) ? form_model.last : form_model).errors.full_messages).each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if local_assigns[:show_credentials] %>
    <%= render 'user_requests/fields', f: f %>
  <% else %>
    <%= render 'user_requests/fields', f: f, hide_credentials: true %>
  <% end %>

  <div class="col-span-6 sm:flex sm:items-center sm:gap-4">
    <div class="inline">
      <%= f.submit submit_label, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  </div>
<% end %>

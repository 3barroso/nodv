<%# Reusable fields for the request form. The admin owner-edit view renders this partial without credentials. %>
<% unless local_assigns[:hide_credentials] %>
  <div class="my-5">
    <%= f.label :email, class: "block font-medium mb-2" %>
    <%= f.email_field :email, id: "user_request_email", required: true, autofocus: true, autocomplete: "email", placeholder: "Enter your email address", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= f.label :password, "Password", class: "block font-medium mb-2" %>
    <%= f.password_field :password, id: "user_request_password", required: true, autocomplete: "new-password", placeholder: "Create a password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= f.label :password_confirmation, "Confirm password", class: "block font-medium mb-2" %>
    <%= f.password_field :password_confirmation, id: "user_request_password_confirmation", required: true, autocomplete: "new-password", placeholder: "Re-enter your password", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>
<% end %>

<div class="my-5">
  <%= f.label :first_name, class: "block font-medium mb-2" %>
  <%= f.text_field :first_name, required: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
</div>

<div class="my-5">
  <%= f.label :last_name, class: "block font-medium mb-2" %>
  <%= f.text_field :last_name, required: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
</div>

<div class="my-5">
  <%= f.label :purpose, class: "block font-medium mb-2" %>
  <%= f.text_area :purpose, required: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
</div>

<div class="my-5">
  <%= f.label :reason, class: "block font-medium mb-2" %>
  <%= f.text_area :reason, required: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
</div>

<div class="my-5">
  <%= f.label :document, "Upload document", class: "block font-medium mb-2" %>
  <%= f.file_field :document, class: "block w-full text-sm text-gray-600" %>
</div>

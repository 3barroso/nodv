<h1>User request</h1>

<p><strong>Email:</strong> <%= @user_request.email %></p>
<p><strong>Name:</strong> <%= @user_request.first_name %> <%= @user_request.last_name %></p>
<p><strong>Purpose:</strong> <%= @user_request.purpose %></p>
<p><strong>Reason:</strong> <%= @user_request.reason %></p>
<p><strong>Submitted:</strong> <%= @user_request.submitted %></p>
<p><strong>Reviewed:</strong> <%= @user_request.reviewed %></p>
<p><strong>Approved:</strong> <%= @user_request.approved %></p>

<% if current_user&.admin? %>
  <%= link_to 'Edit (reviewer)', edit_admin_user_request_path(@user_request) %>
<% elsif @user_request.email == (current_user&.email || session[:user]&.dig("email")) %>
  <%= link_to 'Edit (owner)', edit_admin_user_request_path(@user_request) %>
<% end %>

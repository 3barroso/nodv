<h1 class="text-4xl font-bold mb-6">Admin Phases</h1>
<p class="text-sm text-gray-600 mb-8">View and update phases with expanded descriptions and fast edit links.</p>

<div class="mb-6">
  <button id="toggle-order-mode" class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Adjust phase order</button>
</div>

<% if @phases.any? %>
  <%= render partial: 'admin/phases/list', locals: { phases: @phases } %>
<% else %>
  <div class="rounded-xl border border-gray-200 bg-white p-6 text-sm text-gray-600">No phases found.</div>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('toggle-order-mode');
    let orderMode = (toggleBtn.dataset.orderMode === 'true');

    if (!toggleBtn) return;

    function applyOrderMode() {
      document.querySelectorAll('.order-controls').forEach(el => {
        if (orderMode) el.classList.remove('hidden'); else el.classList.add('hidden');
      });
      toggleBtn.textContent = orderMode ? 'Done adjusting' : 'Adjust phase order';
      toggleBtn.dataset.orderMode = orderMode ? 'true' : 'false';
    }

    toggleBtn.addEventListener('click', () => {
      orderMode = !orderMode;
      applyOrderMode();
    });

    // apply initial state (in case page was re-rendered or persisted)
    applyOrderMode();

    // helper to send PATCH and let Turbo Streams update the DOM
    async function sendMove(id, action) {
      const token = document.querySelector('meta[name="csrf-token"]').content;
      const res = await fetch(`/admin/phases/${id}/${action}`, { method: 'PATCH', headers: { 'X-CSRF-Token': token, 'Accept': 'text/vnd.turbo-stream.html' } });
      if (!res.ok) console.error('Move request failed', res.statusText);
      const text = await res.text();
      if (window.Turbo && text) {
        try {
          Turbo.renderStreamMessage(text);
          // After Turbo replaces the list, re-apply the current orderMode so controls show/hide correctly
          applyOrderMode();
        } catch (err) { console.error(err); }
      }
    }

    // Observe the document body for insertions of the admin_phases_list element.
    // Turbo stream may replace the entire node, so observing the body ensures we
    // detect re-insertions and re-apply the order mode.
    (function observeBodyForList() {
      let lastApplied = 0;
      const bodyObserver = new MutationObserver((mutations) => {
        const now = Date.now();
        if (now - lastApplied < 100) return; // throttle
        for (const m of mutations) {
          for (const node of m.addedNodes) {
            if (!(node instanceof HTMLElement)) continue;
            if (node.id === 'admin_phases_list' || node.querySelector?.('#admin_phases_list')) {
              // re-apply after a short delay to allow Turbo to finish DOM plumbing
              setTimeout(() => applyOrderMode(), 30);
              lastApplied = now;
              return;
            }
          }
        }
      });
      bodyObserver.observe(document.body, { childList: true, subtree: true });
    })();

    document.addEventListener('click', (e) => {
      const up = e.target.closest('[data-action="move-up"]');
      const down = e.target.closest('[data-action="move-down"]');
      if (up) {
        e.preventDefault();
        const id = up.closest('[data-phase-id]').dataset.phaseId;
        sendMove(id, 'move_up');
      } else if (down) {
        e.preventDefault();
        const id = down.closest('[data-phase-id]').dataset.phaseId;
        sendMove(id, 'move_down');
      }
    });
  });
</script>
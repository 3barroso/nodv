<div id="admin_phases_list">
  <div class="space-y-4">
    <% phases.each do |phase| %>
      <article id="<%= dom_id(phase) %>" class="border border-gray-200 rounded-xl overflow-hidden shadow-sm">
        <div class="grid sm:grid-cols-[minmax(0,1fr)_auto] gap-4 px-4 py-4 bg-white items-center">
          <div class="flex items-start gap-3">
            <div class="order-controls hidden" data-phase-id="<%= phase.id %>">
              <button data-action="move-up" class="move-up text-sm text-slate-500 hover:text-slate-900">▲</button>
              <button data-action="move-down" class="move-down text-sm text-slate-500 hover:text-slate-900">▼</button>
            </div>
            <div>
              <h2 class="text-xl font-semibold text-slate-900"><%= phase.name %></h2>
              <p class="text-sm text-gray-500"><%= pluralize(phase.resources.count, "resource") %> assigned</p>
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-end gap-2">
            <%= link_to "Edit", edit_admin_phase_path(phase), class: "inline-flex items-center rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
            <%= link_to "View", phase_path(phase), class: "inline-flex items-center rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
          </div>
        </div>

        <div class="bg-slate-50 px-4 py-3">
          <div class="mt-1 text-sm leading-6 text-slate-700">
            <p><%= phase.description.presence || "No description available." %></p>
          </div>

          <% if phase.sub_phases.any? %>
            <div class="mt-3">
              <ul class="ml-0 space-y-2">
                <% phase.sub_phases.order(:position).each do |sub| %>
                  <li id="<%= dom_id(sub) %>" class="flex items-start gap-3 px-2 py-1 bg-white rounded">
                    <div class="order-controls hidden" data-phase-id="<%= sub.id %>">
                      <button data-action="move-up" class="move-up text-sm text-slate-500 hover:text-slate-900">▲</button>
                      <button data-action="move-down" class="move-down text-sm text-slate-500 hover:text-slate-900">▼</button>
                    </div>
                    <div>
                      <strong class="text-sm"><%= sub.name %></strong>
                      <div class="text-xs text-gray-500"><%= pluralize(sub.resources.count, "resource") %></div>
                    </div>
                    <div class="ml-auto flex gap-2">
                      <%= link_to "Edit", edit_admin_phase_path(sub), class: "inline-flex items-center rounded-md bg-slate-900 px-2 py-1 text-xs font-medium text-white hover:bg-slate-700" %>
                      <%= link_to "View", phase_path(sub), class: "inline-flex items-center rounded-md border border-slate-300 bg-white px-2 py-1 text-xs font-medium text-slate-700 hover:bg-slate-50" %>
                    </div>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
</div>

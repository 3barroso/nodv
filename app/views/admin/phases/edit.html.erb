<div class="max-w-4xl space-y-8">
	<section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
		<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
			<div>
				<h1 class="text-4xl font-bold text-slate-900">Edit phase</h1>
				<p class="mt-2 text-sm text-gray-600">Update the phase details below.</p>
			</div>

			<div class="flex flex-wrap gap-2">
				<%= link_to "Back to phases", admin_phases_path, class: "inline-flex items-center rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
			</div>
		</div>
	</section>

	<section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
		<h2 class="text-2xl font-semibold text-slate-900"><%= @phase.name.presence || 'Phase' %></h2>
		<div class="mt-3 flex flex-wrap gap-4 items-center">
			<div class="text-sm text-gray-500">
				<span class="block">Position: <strong class="text-slate-900"><%= @phase.position || '—' %></strong></span>
			</div>
			<div class="text-sm text-gray-500">
				<% if @phase.parent.present? %>
					<span class="block">Level: <strong class="text-slate-900">Sub-phase</strong> of <%= @phase.parent.name %></span>
				<% else %>
					<span class="block">Level: <strong class="text-slate-900">Top-level phase</strong></span>
				<% end %>
			</div>
		</div>
		<% if @phase.parent.present? %>
			<p class="mt-2 text-sm text-gray-500">Parent phase: <%= link_to @phase.parent.name, phase_path(@phase.parent), class: "ml-2 text-blue-600 hover:text-blue-700" %></p>
		<% end %>

		<%= form_with model: [:admin, @phase], class: "mt-6 space-y-6" do |form| %>
			<% if @phase.errors.any? %>
				<div class="rounded-md bg-red-50 p-4">
					<h3 class="text-sm font-medium text-red-800"><%= pluralize(@phase.errors.count, "error") %> prohibited this phase from being saved:</h3>
					<ul class="mt-2 list-disc pl-5 text-sm text-red-700">
						<% @phase.errors.full_messages.each do |msg| %>
							<li><%= msg %></li>
						<% end %>
					</ul>
				</div>
			<% end %>
			<div>
				<%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
				<%= form.text_field :name, id: "admin_phase_name", class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-slate-500 focus:outline-none focus:ring-slate-500" %>
			</div>

			<div>
				<%= form.label :description, class: "block text-sm font-medium text-slate-700" %>
				<%= form.text_area :description, id: "admin_phase_description", rows: 6, class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-slate-500 focus:outline-none focus:ring-slate-500" %>
				<p class="mt-2 text-sm text-gray-500">A short description for admins. This is visible in the admin listing.</p>
			</div>

			<div class="flex flex-wrap gap-2">
				<%= form.submit "Save phase", class: "inline-flex items-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
				<%= link_to "Cancel", last_request_page(admin_phases_path), class: "inline-flex items-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
			</div>
		<% end %>
	</section>
</div>
